# CSV Viewer configuration — copy to .env and adjust as needed.
# All settings are optional; the defaults shown below are used when a variable is unset.

# Set to true to require login
AUTH_ENABLED=false

# Login username (only used when AUTH_ENABLED=true)
APP_USERNAME=admin

# Login password (only used when AUTH_ENABLED=true)
APP_PASSWORD=admin

# When true, uploaded files live only in session memory (lost on browser close).
# Default is false — files are persisted to DATA_DIR.
SESSION_ONLY=false

# Directory for persistent file storage (used when SESSION_ONLY=false)
DATA_DIR=/tmp/csv-viewer

# Upload size limit in MB
MAX_FILE_SIZE_MB=200

# Streamlit server port (used by Docker / docker-compose; for a standalone run
# pass it explicitly: streamlit run app.py --server.port 8501)
PORT=8501

# Browser tab / header title
APP_TITLE=CSV Viewer
